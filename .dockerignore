backend/
__pycache__/
**/__pycache__/
*.py[cod]
.git/
.venv/
venv/
*.log
# Secrets: inject at runtime via env_file, never bake into a layer.
# The .env.* glob matters as much as .env itself - a stray .env.bak created
# during an incident is still a full copy of every credential, and COPY . .
# will happily bake it into the image.
.env
.env.*

# Editor and ad-hoc backups: never part of a build.
*.bak
*.bak.*
*.save
*~

sms_module_archive/
